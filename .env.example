# Site origin — LOCAL DEVELOPMENT ONLY. On Vercel the canonical origin is fixed in lib/site.ts
# (https://www.gamedayedition.com) and this variable is ignored. Brand name, owner and support
# email are code constants in lib/site.ts, not configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Imprint (seller identification — rendered in the footer only when all four are set)
NEXT_PUBLIC_IMPRINT_LEGAL_NAME=
NEXT_PUBLIC_IMPRINT_COMPANY_CODE=
NEXT_PUBLIC_IMPRINT_VAT=
NEXT_PUBLIC_IMPRINT_ADDRESS=

# Social profiles for Organization JSON-LD (leave empty to omit)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Search / social domain verification (meta tags; leave empty to omit)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Order request API (legacy; unused until the new checkout ships)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=athlete-submissions
SUBMISSION_SIGNING_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=Game Day Edition <orders@gamedayedition.com>
OWNER_NOTIFICATION_EMAIL=

PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
