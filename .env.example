# Site origin — LOCAL DEVELOPMENT ONLY. On Vercel the canonical origin is fixed in lib/site.ts
# (https://www.gamedayedition.com) and this variable is ignored. Brand name, owner and support
# email are code constants in lib/site.ts, not configuration.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Imprint (seller identification — rendered in the footer only when all four are set)
NEXT_PUBLIC_IMPRINT_LEGAL_NAME=
NEXT_PUBLIC_IMPRINT_COMPANY_CODE=
NEXT_PUBLIC_IMPRINT_VAT=
NEXT_PUBLIC_IMPRINT_ADDRESS=

# Social profiles for Organization JSON-LD (leave empty to omit)
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_PINTEREST_URL=
NEXT_PUBLIC_FACEBOOK_URL=

# Search / social domain verification (meta tags; leave empty to omit)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_PINTEREST_DOMAIN_VERIFY=
NEXT_PUBLIC_FACEBOOK_DOMAIN_VERIFICATION=

# Free-proof intake (/free-proof → /api/intake/*). All optional locally: without them
# /api/intake/health reports false, /api/intake/start answers 503 and the form offers email instead.
# Supabase project URL (Project Settings → API), e.g. https://abcd1234.supabase.co
SUPABASE_URL=
# The PUBLIC anon/publishable key — handed to the browser for the signed-upload request headers
SUPABASE_ANON_KEY=
# SERVER ONLY (secret): writes request.json, issues signed upload URLs, signs the owner's 7-day links
SUPABASE_SERVICE_ROLE_KEY=
# A PRIVATE bucket (no public access); no MIME restriction (HEIC can arrive untyped); file limit >= 25 MB
SUPABASE_STORAGE_BUCKET=athlete-submissions
# Random secret (32+ characters) that signs the upload completeToken; unset = derived from the service key
SUBMISSION_SIGNING_SECRET=

# Resend API key (server only); without it requests are still stored, just not emailed
RESEND_API_KEY=
# Sender on a domain verified in Resend; unset = Game Day Edition <hello@gamedayedition.com>
RESEND_FROM_EMAIL=Game Day Edition <hello@gamedayedition.com>
# Where new requests are announced; unset = hello@gamedayedition.com
OWNER_NOTIFICATION_EMAIL=

# Cloudflare Turnstile (optional) — the check runs only when BOTH keys are set
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Meta pixel id for the free-proof funnel (optional; empty = no pixel)
NEXT_PUBLIC_META_PIXEL_ID=
