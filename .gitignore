# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/

# --- Game Day Edition art pipeline -------------------------------------------
# Heavy raw / intermediate art and regenerable renders stay out of git.
# See docs/GAME-DAY-EDITION.md and print-sources/MANIFEST.md for what lives where
# and how to regenerate any of it.
print-sources/upscaled/
print-sources/figma-ready/
print-sources/chrome-allstar/
print-sources/_qa_*.png
print-sources/*.png
!print-sources/pack-assets-foil-pinstripe-tile.png

# poster print masters are 30 MB+ each — re-export from Figma (node 90:2 / 105:1218)
print-sources/output/**/*poster-*.png

# flip inputs are re-exported from Figma at 2x; GIFs are internal preview only
card-flip/assets/
card-flip/out/*.gif
card-flip/out/frames/

# athlete cutouts are per-order and large
exports/shared-cutouts/

# generated art (regenerable — prompts are the source of truth, images are not)
# art-pipeline outputs: the PIXELS stay local (3.9 GB and rising), the DECISIONS are tracked —
# _spec.json, _spec-audit.json, _kit-grade.json, _identity-gate.json, _qa-report.json and
# _cutout-report.json are what a later session needs to know what was decided and why.
art-pipeline/out/**/*.png
art-pipeline/out/**/*.jpg
art-pipeline/out/**/*.jpeg
art-pipeline/out/**/*.webp
art-pipeline/out/**/*.mp4
art-pipeline/out/_labelled/

# local python venv for matting + face embeddings (art-pipeline/lib/*.py)
.venv-matte/

# firecrawl scratch
.firecrawl/

# Etsy listing image exports are regenerated from Figma (JcQvsgIRiOQtuZcP3Q8dc9) - ~90 MB of PNGs.
etsy/listing-images/

# marketing — rendered pins are reproducible from the queue, never committed
/marketing/out/

# marketing — card renders re-exportable from Figma, kept out of git
/marketing/cards/

# Real customer orders: uploaded photos and per-order working art are personal data.
orders/

# 2026-09-05 — listing-video work: frames, Veo/owner clips and the rendered listing videos are
# regenerable (etsy/video/render_*.py) and live on Etsy; only the scripts + storyboards are tracked
etsy/video/_frames/
etsy/video/_frames_v3/
etsy/video/trial/
etsy/video/Video failai sugeneruoti/
etsy/listing-videos/
etsy/SEO/screenshots/

# owner's local Figma exports and build cache
/Exportai Etsy/
tsconfig.tsbuildinfo

# marketing renders (social/upload/video) are rebuilt from the queue, like out/ and cards/
marketing/social/
marketing/upload/
marketing/video/

# raw finish backgrounds (same rule as print-sources/chrome-allstar/) — regenerable, 16–20 MB each
print-sources/Fire-and-smoke/
print-sources/Heritage/
print-sources/Signature-spotlight/
print-sources/prism-rush/

# real customer orders under the athlete pipeline are personal data (photos, names, stats)
art-pipeline/out/athletes/[Oo]rder*/
art-pipeline/out/approved/[Oo]rder*/

# order symlinks/files too, not only directories
art-pipeline/out/athletes/order-*
art-pipeline/out/approved/order-*
